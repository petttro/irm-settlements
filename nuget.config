<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nexus-nuget-releases">
            <package pattern="*" />
        </packageSource>
        <packageSource key="nexus-nuget-public">
            <package pattern="*" />
        </packageSource>
        <packageSource key="nexus-nuget-nugetorg">
            <package pattern="*" />
        </packageSource>
        <packageSource key="nuget">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
